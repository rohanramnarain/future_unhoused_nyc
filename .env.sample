MAPBOX_TOKEN=pk.your-mapbox-token-here
CENSUS_API_KEY=
SOCRATA_APP_TOKEN=

# Optional overrides; fall back to defaults if blank
APP_HOST=127.0.0.1
APP_PORT=8050
RANDOM_SEED=1729
ADVANCED_MODEL=false

# ZIP-level economic scenario controls (future-year feature multipliers)
USE_ZIP_ECON_SCENARIO=true
ZIP_ECON_SCENARIO_PATH=data/interim/zip_econ_scenario_2027_2029.csv
ZIP_ECON_SCENARIO_YEARS=2027,2028,2029

# Leave empty to use the default NYC Open Data dataset for filed evictions
FILED_EVICTIONS_DATASET=

